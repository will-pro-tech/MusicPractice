modules = ["nodejs-24", "postgresql-16", "web"]

run = "pnpm run dev"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

# Published app. Builds the client + server, then runs the bundled server.
# `pnpm run start` sets NODE_ENV=production so the server serves the built
# files (instead of the Vite dev middleware). Replit injects DATABASE_URL.
[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

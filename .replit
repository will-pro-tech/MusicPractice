modules = ["nodejs-24", "postgresql-16"]

run = "pnpm run dev"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[env]
PORT = "8081"

# Published app. Builds the client + server, then runs the bundled server.
# `pnpm run start` sets NODE_ENV=production so the server serves the built
# files (instead of the Vite dev middleware). Replit injects DATABASE_URL.
[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]
